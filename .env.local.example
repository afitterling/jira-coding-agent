# Copy to .env.local and fill in. SST loads .env.local automatically.

# --- Jira (Cloud) ---
JIRA_HOST=your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-jira-api-token
# Optional: override the board query. Defaults to the revise/ready/implemented/tested labels.
# JIRA_JQL=project = ABC ORDER BY updated DESC

# Optional: also drive the native Jira workflow (status transitions), not just labels.
# JIRA_DRIVE_STATUS=true
# STATUS_IMPLEMENTED=In Review
# STATUS_TESTED=In QA
# STATUS_TESTS_FAILED=In Progress
# STATUS_QA_PASSED=Done
# STATUS_QA_FAILED=In Progress

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Label mapping (Jira labels can't contain '#') ---
LABEL_REVISE=revise
LABEL_UNDONE=undone
LABEL_REVISED=revised
LABEL_READY=ready
LABEL_IMPLEMENTED=implemented
LABEL_TESTED=tested
LABEL_TESTS_FAILED=tests-failed
LABEL_QA_PASSED=qa-passed
LABEL_QA_FAILED=qa-failed
LABEL_DONE=done
