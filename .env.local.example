# Copy to .env.local and fill in. SST loads .env.local automatically.

# --- Jira (Cloud) ---
JIRA_HOST=your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-jira-api-token
# Optional: override the board query. Defaults to the revise/ready/implemented/tested labels.
# JIRA_JQL=project = ABC ORDER BY updated DESC

# Optional: also drive the native Jira workflow (status transitions), not just labels.
# JIRA_DRIVE_STATUS=true
# STATUS_IMPLEMENTED=In Review
# STATUS_TESTED=In QA
# STATUS_TESTS_FAILED=In Progress
# STATUS_QA_PASSED=Done
# STATUS_QA_FAILED=In Progress

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Execute mode ---
# "inline"  = generate implementation in-process, post as a Jira comment (default)
# "fargate" = dispatch an isolated Fargate runner that clones the repo, runs the
#             Claude Code CLI, runs tests, and opens a PR (needs TARGET_REPO + GITHUB_TOKEN)
EXECUTE_MODE=inline
# TARGET_REPO=https://github.com/your-org/your-repo
# GITHUB_TOKEN=ghp_...   # used by the runner to clone + open PRs

# --- Multi-tenancy (optional) — see docs/tenant-isolation.md ---
# Leave unset for single-tenant (uses the JIRA_* values above as tenant "default").
# TENANTS=[{"id":"acme","jiraHost":"acme.atlassian.net","jiraEmail":"bot@acme.com","jiraToken":"...","targetRepo":"https://github.com/acme/app"}]
# TENANT_IDS=acme,globex   # tenants shown in the dashboard selector

# --- Label mapping (Jira labels can't contain '#') ---
LABEL_REVISE=revise
LABEL_UNDONE=undone
LABEL_REVISED=revised
LABEL_READY=ready
LABEL_IMPLEMENTED=implemented
LABEL_DISPATCHED=agent-dispatched
LABEL_TESTED=tested
LABEL_TESTS_FAILED=tests-failed
LABEL_QA_PASSED=qa-passed
LABEL_QA_FAILED=qa-failed
LABEL_DONE=done
