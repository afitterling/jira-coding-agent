# Copy to .env.local and fill in. SST loads .env.local automatically.

# --- Jira (Cloud) ---
JIRA_HOST=your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-jira-api-token
# Optional: override the board query. Defaults to the revise/ready labels below.
# JIRA_JQL=project = ABC ORDER BY updated DESC

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Label mapping (Jira labels can't contain '#') ---
LABEL_REVISE=revise
LABEL_UNDONE=undone
LABEL_REVISED=revised
LABEL_READY=ready
LABEL_IMPLEMENTED=implemented
